#!/usr/bin/env python3
"""Convenience launcher so `bin/wallgen` works without installing."""
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from wallgen.cli import main  # noqa: E402

if __name__ == "__main__":
    main()